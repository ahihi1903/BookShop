generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  CARD
  E_WALLET
}

enum MembershipLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id              String         @id @default(cuid()) @db.VarChar(30)
  name            String         @db.VarChar(120)
  email           String         @unique @db.VarChar(254)
  password        String         @db.VarChar(255) // bcrypt hash only; never plaintext
  phone           String?        @unique @db.VarChar(30)
  address         String?        @db.VarChar(500)
  role            UserRole       @default(CUSTOMER)
  status          RecordStatus   @default(ACTIVE)
  points          Int            @default(0)
  membershipLevel MembershipLevel @default(BRONZE)
  cart            Cart?
  orders          Order[]
  reviews         Review[]
  favorites       Favorite[]
  giftCards       GiftCard[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([role, status])
}

model Category {
  id          String       @id @default(cuid()) @db.VarChar(30)
  name        String       @db.VarChar(120)
  slug        String       @unique @db.VarChar(140)
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  books       Book[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, name])
}

model Book {
  id          String       @id @default(cuid()) @db.VarChar(30)
  title       String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(280)
  author      String       @db.VarChar(180)
  isbn        String?      @unique @db.VarChar(20)
  description String?      @db.Text
  image       String?      @db.VarChar(2048)
  price       Decimal      @db.Decimal(10, 2)
  discountPrice Decimal?   @db.Decimal(10, 2)
  stock       Int          @default(0)
  publisher   String?      @db.VarChar(180)
  publishedAt DateTime?
  status      RecordStatus @default(ACTIVE)
  categoryId  String       @db.VarChar(30)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  favorites   Favorite[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId, status])
  @@index([title])
  @@index([author])
}

model Cart {
  id        String     @id @default(cuid()) @db.VarChar(30)
  userId    String     @unique @db.VarChar(30)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid()) @db.VarChar(30)
  cartId    String   @db.VarChar(30)
  bookId    String   @db.VarChar(30)
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, bookId])
  @@index([bookId])
}

model Order {
  id                String       @id @default(cuid()) @db.VarChar(30)
  orderNumber       String       @unique @db.VarChar(40)
  userId            String       @db.VarChar(30)
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderStatus       OrderStatus  @default(PENDING)
  subtotal          Decimal      @db.Decimal(10, 2)
  discount          Decimal      @default(0) @db.Decimal(10, 2)
  shippingFee       Decimal      @default(0) @db.Decimal(10, 2)
  total             Decimal      @db.Decimal(10, 2)
  shippingAddress   String       @db.VarChar(500)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  note              String?      @db.VarChar(1000)
  promotionId       String?      @db.VarChar(30)
  promotion         Promotion?   @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([orderStatus, createdAt])
}

model OrderItem {
  id           String   @id @default(cuid()) @db.VarChar(30)
  orderId      String   @db.VarChar(30)
  bookId       String   @db.VarChar(30)
  title        String   @db.VarChar(255)
  unitPrice    Decimal  @db.Decimal(10, 2)
  quantity     Int
  subtotal     Decimal  @db.Decimal(10, 2)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bookId])
}

model Review {
  id        String       @id @default(cuid()) @db.VarChar(30)
  userId    String       @db.VarChar(30)
  bookId    String       @db.VarChar(30)
  rating    Int
  comment   String?      @db.Text
  status    RecordStatus @default(ACTIVE)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, bookId])
  @@index([bookId, status])
}

model Favorite {
  userId    String   @db.VarChar(30)
  bookId    String   @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, bookId])
  @@index([bookId])
}

model NewsletterSubscriber {
  id        String       @id @default(cuid()) @db.VarChar(30)
  email     String       @unique @db.VarChar(254)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, createdAt])
}

model Membership {
  id          String         @id @default(cuid()) @db.VarChar(30)
  level       MembershipLevel @unique
  name        String         @db.VarChar(80)
  minPoints   Int            @default(0)
  description String?        @db.Text
  status      RecordStatus   @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, minPoints])
}

model Promotion {
  id             String       @id @default(cuid()) @db.VarChar(30)
  code           String       @unique @db.VarChar(40)
  name           String       @db.VarChar(120)
  description    String?      @db.Text
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0) @db.Decimal(10, 2)
  startsAt       DateTime
  endsAt         DateTime
  usageLimit     Int?
  usedCount      Int          @default(0)
  status         RecordStatus @default(ACTIVE)
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, startsAt, endsAt])
}

model GiftCard {
  id            String       @id @default(cuid()) @db.VarChar(30)
  code          String       @unique @db.VarChar(40)
  initialValue  Decimal      @db.Decimal(10, 2)
  balance       Decimal      @db.Decimal(10, 2)
  expiresAt     DateTime?
  status        RecordStatus @default(ACTIVE)
  ownerId       String?      @db.VarChar(30)
  owner         User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([ownerId, status])
}

model Gift {
  id            String       @id @default(cuid()) @db.VarChar(30)
  name          String       @db.VarChar(160)
  description   String?      @db.Text
  imageUrl      String?      @db.VarChar(2048)
  pointsCost    Int
  stock         Int          @default(0)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, pointsCost])
}

model Payment {
  id              String        @id @default(cuid()) @db.VarChar(30)
  orderId         String        @db.VarChar(30)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)
  provider        String?       @db.VarChar(80)
  transactionRef  String?       @unique @db.VarChar(160)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId, status])
}
